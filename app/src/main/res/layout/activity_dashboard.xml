<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/of_white"
    tools:context=".Dashboard">

    <!-- Top Bar -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/blue"
        android:paddingHorizontal="@dimen/_16sdp"
        android:paddingVertical="@dimen/_12sdp">

        <!-- Welcome Title -->
        <TextView
            android:id="@+id/Dashboard_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/topbar_icons"
            android:textColor="@color/white"
            android:textSize="@dimen/_18sdp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Right-side icon group -->
        <LinearLayout
            android:id="@+id/topbar_icons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Wishlist Button -->
            <ImageButton
                android:id="@+id/Dashboard_wishlist_btn"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_wishlist"
                android:scaleType="centerInside"
                android:contentDescription="Wishlist" />

            <!-- Cart Button -->
            <ImageButton
                android:id="@+id/Dashboard_cart_btn"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:layout_marginEnd="@dimen/_10sdp"

                android:src="@drawable/cart"
                android:scaleType="centerInside"
                android:contentDescription="Cart" />

            <!-- Profile Icon Button -->
            <ImageButton
                android:id="@+id/Dashboard_profile_btn"
                android:layout_width="@dimen/_25sdp"
                android:layout_height="@dimen/_25sdp"
                android:background="@drawable/ic_profile_circle"
                android:src="@drawable/user"
                android:scaleType="centerCrop"
                android:contentDescription="Profile" />

        </LinearLayout>

    </RelativeLayout>

    <!-- Category Header Label -->
    <TextView
        android:id="@+id/Dashboard_category_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/topBar"
        android:layout_marginStart="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_16sdp"
        android:layout_marginBottom="@dimen/_8sdp"
        android:text="Event Categories"
        android:textColor="@color/gray"
        android:textSize="@dimen/_16sdp"
        android:textStyle="bold" />

    <!-- Category RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/Dashboard_category_recycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/Dashboard_category_label"
        android:paddingHorizontal="@dimen/_8sdp"
        android:clipToPadding="false" />

</RelativeLayout>