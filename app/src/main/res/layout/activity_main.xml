<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">
    
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView

                android:layout_marginTop="@dimen/_20sdp"
                android:id="@+id/main_image"
                android:layout_centerHorizontal="true"
                android:layout_width="@dimen/_150sdp"
                android:layout_height="@dimen/_150sdp"
                android:src="@drawable/login_logo" />

            <TextView
                style="@style/text_20"
                android:textStyle="bold"
                android:layout_marginTop="@dimen/_20sdp"
                android:id="@+id/main_Title"
                android:layout_below="@+id/main_image"
                android:text= "Login to your Account"
                />

            <androidx.cardview.widget.CardView
                android:elevation="@dimen/_3sdp"
                android:layout_marginBottom="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginHorizontal="@dimen/_20sdp"
                app:cardCornerRadius="@dimen/_10sdp"
                android:id="@+id/main_Email_card"
                android:layout_below="@+id/main_Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/main_Email"
                    style="@style/edit_14"
                    android:inputType="textEmailAddress"
                    android:hint = "Email or Phone number" />

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:elevation="@dimen/_3sdp"
                android:layout_marginBottom="@dimen/_5sdp"
                app:cardCornerRadius="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginHorizontal="@dimen/_20sdp"
                android:layout_below="@+id/main_Email_card"
                android:id="@+id/main_Password_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/main_Password"
                    style="@style/edit_14"
                    android:inputType="textPassword"
                    android:hint = "Password" />
            </androidx.cardview.widget.CardView>


            <androidx.appcompat.widget.AppCompatButton
                style="@style/button_14"
                android:text="login"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginHorizontal="@dimen/_20sdp"
                android:id="@+id/main_button"
                android:layout_below="@+id/main_Password_card"
                />
            <TextView
                style="@style/text_14_1"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/_20sdp"
                android:id="@+id/main_login"
                android:layout_below="@+id/main_button"
                android:text= "-- or login with --"

                />

            <LinearLayout
                android:id="@+id/main_raf"
                android:weightSum="3"
                android:layout_marginTop="@dimen/_30sdp"
                android:layout_marginHorizontal="@dimen/_20sdp"
                android:layout_below="@id/main_login"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.cardview.widget.CardView
                    android:elevation="@dimen/_3sdp"
                    app:cardCornerRadius="@dimen/_10sdp"
                    android:layout_margin="@dimen/_5sdp"
                    android:layout_weight="1"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_50sdp">

                    <ImageView
                        android:layout_height="@dimen/_40sdp"
                        android:layout_gravity="center"
                        android:layout_width="match_parent"
                        android:src="@drawable/google"/>

                </androidx.cardview.widget.CardView>


                <androidx.cardview.widget.CardView
                    android:elevation="@dimen/_3sdp"
                    app:cardCornerRadius="@dimen/_10sdp"
                    android:layout_margin="@dimen/_5sdp"
                    android:layout_weight="1"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_50sdp">

                    <ImageView
                        android:layout_height="@dimen/_40sdp"
                        android:layout_gravity="center"
                        android:layout_width="match_parent"
                        android:src="@drawable/facebook"/>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:elevation="@dimen/_3sdp"
                    app:cardCornerRadius="@dimen/_10sdp"
                    android:layout_margin="@dimen/_5sdp"
                    android:layout_weight="1"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_50sdp">

                    <ImageView
                        android:layout_height="@dimen/_40sdp"
                        android:layout_gravity="center"
                        android:layout_width="match_parent"
                        android:src="@drawable/twitter"/>

                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <LinearLayout
                android:gravity="center"
                android:layout_marginTop="@dimen/_40sdp"
                android:layout_below="@+id/main_raf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    style="@style/text_14_2"
                    android:text="Don't have an Account? "
                    tools:ignore="HardcodedText" />
                <TextView
                    android:id="@+id/main_createAccount"
                    style="@style/text_14_2"
                    android:textColor="@color/Light_blue"

                    android:text="Create Account"/>

            </LinearLayout>


        </RelativeLayout>
    </ScrollView>



</RelativeLayout>