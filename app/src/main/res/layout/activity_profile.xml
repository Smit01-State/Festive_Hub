<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                style="@style/text_20"
                android:textStyle="bold"
                android:layout_marginTop="@dimen/_20sdp"
                android:id="@+id/main_Title"
                android:text= "Profile Detail "
                />

            <!-- personName-->
            <androidx.cardview.widget.CardView
                android:id="@+id/Profile_name_card"
                android:layout_below="@+id/main_Title"
                android:elevation="@dimen/_3sdp"
                android:layout_marginBottom="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginHorizontal="@dimen/_20sdp"
                app:cardCornerRadius="@dimen/_10sdp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/Profile_name"
                    style="@style/edit_14"
                    android:inputType="textPersonName"
                    android:hint = "Name" />

            </androidx.cardview.widget.CardView>
            <!--    Email-->
            <androidx.cardview.widget.CardView
                android:id="@+id/Profile_Email_card"
                android:layout_below="@+id/Profile_name_card"
                android:elevation="@dimen/_3sdp"
                android:layout_marginBottom="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginHorizontal="@dimen/_20sdp"
                app:cardCornerRadius="@dimen/_10sdp"

                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/Profile_Email"
                    style="@style/edit_14"
                    android:inputType="textEmailAddress"
                    android:hint = "Email" />

            </androidx.cardview.widget.CardView>
            <!--Contact no.-->
            <androidx.cardview.widget.CardView
                android:id="@+id/Profile_contact_card"
                android:layout_below="@+id/Profile_Email_card"
                android:elevation="@dimen/_3sdp"
                android:layout_marginBottom="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginHorizontal="@dimen/_20sdp"
                app:cardCornerRadius="@dimen/_10sdp"

                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/Profile_contact"
                    style="@style/edit_14"
                    android:inputType="phone"
                    android:hint = "Contact no." />

            </androidx.cardview.widget.CardView>
            <!-- password-->
            <androidx.cardview.widget.CardView
                android:id="@+id/Profile_password_card"
                android:layout_below="@+id/Profile_contact_card"
                android:elevation="@dimen/_3sdp"
                android:layout_marginBottom="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginHorizontal="@dimen/_20sdp"
                app:cardCornerRadius="@dimen/_10sdp"

                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/Profile_password"
                    style="@style/edit_14"
                    android:inputType="textPassword"
                    android:hint = "Password" />

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:visibility="gone"
                android:id="@+id/Profile_Confirm_password_card"
                android:layout_below="@+id/Profile_password_card"
                android:elevation="@dimen/_3sdp"
                android:layout_marginBottom="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginHorizontal="@dimen/_20sdp"
                app:cardCornerRadius="@dimen/_10sdp"

                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/Profile_Confirm_password"
                    style="@style/edit_14"
                    android:inputType="textPassword"
                    android:hint = "confirm Password" />

            </androidx.cardview.widget.CardView>
            <!--conform password-->

            <RadioGroup
                android:id="@+id/Profile_radioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/Profile_Confirm_password_card"
                android:layout_marginHorizontal="@dimen/_20sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:orientation="horizontal">

                <RadioButton
                    android:layout_weight="1"
                    android:id="@+id/Profile_radio_male"
                    style="@style/radio_15"
                    android:text="Male" />

                <RadioButton
                    android:layout_weight="1"
                    android:id="@+id/Profile_radio_female"
                    style="@style/radio_15"
                    android:text="Female" />

            </RadioGroup>

            <Spinner
                android:id="@+id/Profile_Spinner"
                android:layout_below="@+id/Profile_radioGroup"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginHorizontal="@dimen/_20sdp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                />



            <androidx.appcompat.widget.AppCompatButton

                android:id="@+id/Profile_Edit_button"
                android:layout_below="@+id/Profile_Spinner"
                style="@style/button_14"
                android:text="Edit"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginHorizontal="@dimen/_20sdp"

                />

            <androidx.appcompat.widget.AppCompatButton
                android:visibility="gone"
                android:id="@+id/Profile_Update_button"
                android:layout_below="@+id/Profile_Spinner"
                style="@style/button_14"
                android:text="Update"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginHorizontal="@dimen/_20sdp"

                />


        </RelativeLayout>
    </ScrollView>



</RelativeLayout>