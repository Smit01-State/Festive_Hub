<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                style="@style/text_20"
                android:textStyle="bold"
                android:layout_marginTop="@dimen/_20sdp"
                android:id="@+id/main_Title"
                android:text= "Create your Account"
                />

            <!-- personName-->
            <androidx.cardview.widget.CardView
                android:id="@+id/Create_name_card"
                android:layout_below="@+id/main_Title"
                android:elevation="@dimen/_3sdp"
                android:layout_marginBottom="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginHorizontal="@dimen/_20sdp"
                app:cardCornerRadius="@dimen/_10sdp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/Create_name"
                    style="@style/edit_14"
                    android:inputType="textPersonName"
                    android:hint = "Name" />

            </androidx.cardview.widget.CardView>
            <!--    Email-->
            <androidx.cardview.widget.CardView
                android:id="@+id/Create_Email_card"
                android:layout_below="@+id/Create_name_card"
                android:elevation="@dimen/_3sdp"
                android:layout_marginBottom="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginHorizontal="@dimen/_20sdp"
                app:cardCornerRadius="@dimen/_10sdp"

                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/Create_Email"
                    style="@style/edit_14"
                    android:inputType="textEmailAddress"
                    android:hint = "Email" />

            </androidx.cardview.widget.CardView>
            <!--Contact no.-->
            <androidx.cardview.widget.CardView
                android:id="@+id/Create_contact_card"
                android:layout_below="@+id/Create_Email_card"
                android:elevation="@dimen/_3sdp"
                android:layout_marginBottom="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginHorizontal="@dimen/_20sdp"
                app:cardCornerRadius="@dimen/_10sdp"

                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/Create_contact"
                    style="@style/edit_14"
                    android:inputType="phone"
                    android:hint = "Contact no." />

            </androidx.cardview.widget.CardView>
            <!-- password-->
            <androidx.cardview.widget.CardView
                android:id="@+id/Create_password_card"
                android:layout_below="@+id/Create_contact_card"
                android:elevation="@dimen/_3sdp"
                android:layout_marginBottom="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginHorizontal="@dimen/_20sdp"
                app:cardCornerRadius="@dimen/_10sdp"

                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/Create_password"
                    style="@style/edit_14"
                    android:inputType="textPassword"
                    android:hint = "Password" />

            </androidx.cardview.widget.CardView>
            <!--conform password-->
            <androidx.cardview.widget.CardView
                android:id="@+id/Create_Confirm_password_card"
                android:layout_below="@+id/Create_password_card"
                android:elevation="@dimen/_3sdp"
                android:layout_marginBottom="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginHorizontal="@dimen/_20sdp"
                app:cardCornerRadius="@dimen/_10sdp"

                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/Create_Confirm_password"
                    style="@style/edit_14"
                    android:inputType="textPassword"
                    android:hint = "Confirm Password" />

            </androidx.cardview.widget.CardView>

            <androidx.appcompat.widget.AppCompatButton

                android:id="@+id/Create_button"
                android:layout_below="@+id/Create_Confirm_password_card"
                style="@style/button_14"
                android:text="sign up"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginHorizontal="@dimen/_20sdp"

                />

            <TextView
                style="@style/text_14_1"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/_20sdp"
                android:id="@+id/Create_signup"
                android:layout_below="@+id/Create_button"
                android:text= "-- or sign up with --"

                />

            <LinearLayout
                android:id="@+id/Create_raf"
                android:weightSum="3"
                android:layout_marginTop="@dimen/_30sdp"
                android:layout_marginHorizontal="@dimen/_20sdp"
                android:layout_below="@id/Create_signup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.cardview.widget.CardView
                    android:elevation="@dimen/_3sdp"
                    app:cardCornerRadius="@dimen/_10sdp"
                    android:layout_margin="@dimen/_5sdp"
                    android:layout_weight="1"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_50sdp">

                    <ImageView
                        android:layout_height="@dimen/_40sdp"
                        android:layout_gravity="center"
                        android:layout_width="match_parent"
                        android:src="@drawable/google"/>

                </androidx.cardview.widget.CardView>


                <androidx.cardview.widget.CardView
                    android:elevation="@dimen/_3sdp"
                    app:cardCornerRadius="@dimen/_10sdp"
                    android:layout_margin="@dimen/_5sdp"
                    android:layout_weight="1"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_50sdp">

                    <ImageView
                        android:layout_height="@dimen/_40sdp"
                        android:layout_gravity="center"
                        android:layout_width="match_parent"
                        android:src="@drawable/facebook"/>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:elevation="@dimen/_3sdp"
                    app:cardCornerRadius="@dimen/_10sdp"
                    android:layout_margin="@dimen/_5sdp"
                    android:layout_weight="1"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_50sdp">

                    <ImageView
                        android:layout_height="@dimen/_40sdp"
                        android:layout_gravity="center"
                        android:layout_width="match_parent"
                        android:src="@drawable/twitter"/>

                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <LinearLayout
                android:gravity="center"
                android:layout_marginTop="@dimen/_40sdp"
                android:layout_below="@+id/Create_raf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    style="@style/text_14_2"
                    android:text=" already have an account? "
                    tools:ignore="HardcodedText" />
                <TextView
                    android:id="@+id/Create_login"
                    style="@style/text_14_2"
                    android:textColor="@color/Light_blue"
                    android:text="login"/>

            </LinearLayout>




        </RelativeLayout>
    </ScrollView>



</RelativeLayout>