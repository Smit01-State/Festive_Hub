<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/of_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/title_add_edit_event"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add New Event"
            android:textSize="22sp"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/et_event_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Event Name"
            android:inputType="text"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/et_vendor_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Vendor Name"
            android:inputType="text"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Event Category"
            android:textColor="@color/gray"
            android:layout_marginTop="12dp"
            android:layout_marginStart="4dp" />

        <Spinner
            android:id="@+id/spinner_category"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@android:drawable/btn_dropdown"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <EditText
                android:id="@+id/et_event_price"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="Price (₹)"
                android:inputType="numberDecimal"
                android:layout_marginEnd="6dp" />

            <EditText
                android:id="@+id/et_event_disc_price"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="Disc. Price"
                android:inputType="numberDecimal"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <EditText
            android:id="@+id/et_event_discount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Discount Tag (e.g. 10%)"
            android:inputType="text"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/et_event_image_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Image Name"
            android:inputType="text"
            android:layout_marginTop="12dp" />
            
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <EditText
                android:id="@+id/et_event_date"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="Date (YYYY-MM-DD)"
                android:inputType="date"
                android:layout_marginEnd="6dp" />

            <EditText
                android:id="@+id/et_event_time"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="Time (HH:MM)"
                android:inputType="time"
                android:layout_marginStart="6dp" />
        </LinearLayout>
        
        <EditText
            android:id="@+id/et_event_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Location"
            android:inputType="text"
            android:layout_marginTop="12dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_save_event"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Event"
            android:textColor="@color/white"
            android:backgroundTint="@color/blue"
            android:textStyle="bold"
            android:padding="12dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>
